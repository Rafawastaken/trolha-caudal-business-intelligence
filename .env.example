# Base URL da Trolha Tracking API.
# Vazio = mesma origem (o proxy do Vite reencaminha /kpi-api em dev).
VITE_API_URL=

# Alvo do proxy de dev para /kpi-api (só usado em `npm run dev`).
VITE_API_PROXY_TARGET=https://www.trolha.pt

# Google AI (Gemini) — o assistente chama a Generative Language API
# diretamente do browser (ferramenta protegida por login).
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-2.5-flash
